# ==========================================
# Business Review Platform - Environment Config
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Authentication & Sessions
JWT_SECRET=replace_with_a_secure_random_64_char_secret_for_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_key
SESSION_SECRET=replace_with_a_secure_session_secret_key

# Database (PostgreSQL)
# e.g., postgresql://username:password@localhost:5432/review_platform
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/review_platform
# Embedded database file fallback for frictionless local testing if PostgreSQL is not running
DATABASE_FILE=./data/review_platform.json

# Redis (Caching, Rate Limiting, Session Storage)
# e.g., redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Google Gemini AI Service
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Object Storage (S3 / Cloud Storage for Logos, QR Codes, Cover Images)
STORAGE_PROVIDER=local
STORAGE_BUCKET=review-platform-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# AWS SNS SMS Service (Phone Verification OTP)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SNS_SENDER_ID=KNDLYREV
# Optional: India TRAI DLT Entity & Template IDs for commercial SMS
AWS_SNS_ENTITY_ID=
AWS_SNS_TEMPLATE_ID=

# Platform Admin Initial Seed (Created if no admin exists)
ADMIN_EMAIL=admin@kindlyrate.com
ADMIN_INITIAL_PASSWORD=AdminSecurePassword123!

