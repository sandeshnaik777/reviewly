# ==========================================
# Reviewly Backend - Production Configuration
# ==========================================

PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Authentication & Cookies
JWT_SECRET=replace_with_a_secure_random_64_char_secret_for_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_key
SESSION_SECRET=replace_with_a_secure_session_secret_key

# PostgreSQL Production Database (e.g., Supabase / Neon / AWS RDS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/review_platform
# Local file storage fallback
DATABASE_FILE=./data/review_platform.json

# Redis Caching & Rate Limiting
REDIS_URL=redis://localhost:6379

# Google Gemini AI Service
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_reviewplatform
RAZORPAY_KEY_SECRET=rzp_test_secret_sample
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_sample

# Initial Admin Credentials
ADMIN_EMAIL=admin@reviewplatform.local
ADMIN_INITIAL_PASSWORD=AdminSecurePassword123!

# Email Service & SMTP (Optional: in development, OTP codes print to server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Reviewly <no-reply@reviewly.local>
